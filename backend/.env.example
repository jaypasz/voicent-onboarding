# Local development: SQLite, no login.
APP_ENV=local
AUTH_DISABLED=1
DATABASE_URL=sqlite:///./onboarding.db
CORS_ORIGINS=http://localhost:5173

# Production (Railway): see DEPLOY.md. Never set AUTH_DISABLED there.
# APP_ENV=production
# DATABASE_URL=postgresql://...            # Supabase pooler URI
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=                      # only for projects still on the legacy HS256 secret
# SERVICE_TOKENS=                           # random, 24+ chars each, comma-separated
# APP_URL=https://<service>.up.railway.app  # builds client links
# CORS_ORIGINS=https://<service>.up.railway.app

# Optional features. Each switches itself off, with a warning, when half-set.
# File uploads (private Supabase Storage bucket):
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# UPLOAD_BUCKET=onboarding-files
# Magic links:
# LINK_TTL_DAYS=30
# SMS nudges (Twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Email nudges (Resend):
# RESEND_API_KEY=
# RESEND_FROM=Voicent <onboarding@your-verified-domain>
# Sync into the AIOS app:
# AIOS_API_URL=https://voicent-aios-app-production.up.railway.app
# AIOS_SERVICE_TOKEN=
