{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onboarding template",
  "description": "The one document format for templates. YAML is only import and export over this; the v2 GUI builder edits this same document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "layout", "steps"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "maxLength": 1000},
    "layout": {"enum": ["focus", "checklist"]},
    "nudge_after_days": {"type": "integer", "minimum": 1, "maximum": 30},
    "on_complete": {"enum": ["none", "provision_voicent_workspace"]},
    "sections": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "title"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "type", "title"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "type": {"type": "string", "minLength": 1, "maxLength": 40},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "description": {"type": "string", "maxLength": 2000},
          "section": {"type": "string", "maxLength": 64},
          "visibility": {"enum": ["client", "internal"]},
          "assignee_role": {"type": "string", "maxLength": 40},
          "due_offset_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 365},
          "config": {"type": "object"},
          "show_if": {"type": ["object", "null"]}
        }
      }
    }
  }
}
